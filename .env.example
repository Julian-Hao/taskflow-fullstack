# 复制为 .env 后按需修改

# 运行环境：development | production | test
NODE_ENV=development

# 监听地址与端口
HOST=0.0.0.0
PORT=3000

# SQLite 数据文件路径（设为 :memory: 可跑纯内存实例）
DB_FILE=./data/taskflow.db

# 前端构建产物目录（生产模式下由 Express 托管）
STATIC_DIR=./dist

# 会话有效期（小时），默认 30 天
SESSION_TTL_HOURS=720

# scrypt 代价参数，调高更安全但更慢
SCRYPT_COST=16384
